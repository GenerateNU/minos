# Copy to .env and pick one DATABASE_URL by commenting out the other.
# The deployed API gets DATABASE_URL from Neon through the host's settings.

# Neon dev branch. Get the string with:
#   npx neon@latest cs dev --project-id rough-term-28961575
# then change its start from postgresql:// to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require

# Docker Postgres from docker-compose.yml (start with: docker compose up -d)
DATABASE_URL=postgresql+psycopg://minos:minos@localhost:5433/minos
